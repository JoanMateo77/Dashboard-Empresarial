# ---------------------------------------------------------------------------
# Clerk (autenticacion) - https://dashboard.clerk.com
# Las dos claves son obligatorias: sin ellas el build falla al prerenderizar.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rutas de Clerk (opcional, ya hay valores por defecto en la app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Marca blanca (white-label)
# Cambia estos valores para renombrar el dashboard sin tocar el codigo.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Nimbus
NEXT_PUBLIC_APP_DESCRIPTION=Panel de administracion para gestionar empresas y clientes
# URL publica del sitio (se usa para metadatos / Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000
